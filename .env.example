# For local dev without Docker, use DATABASE_URL="file:./dev.db" and switch
# prisma/schema.prisma back to provider = "sqlite". This file is set up for
# the bundled docker-compose Postgres instead.

APP_PORT=3000
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://cdm:change_me@db:5432/cdm"

NEXTAUTH_URL="https://cdm.yourcompany.com"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

ANTHROPIC_API_KEY="sk-ant-..."
RECALL_API_KEY="your-recall-api-key"
RECALL_REGION="us-west-2"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

NODE_ENV="production"
