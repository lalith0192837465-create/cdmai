{
  "name": "cdm-google-cloud",
  "version": "1.2.4",
  "private": true,
  "description": "CDM Google Cloud direct application installer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.cdm.google-cloud",
    "productName": "CDM Google Cloud",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "gcp-cli.exe",
        "to": "gcp-cli.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CDM-GCP-Setup.${ext}"
    },
    "portable": {
      "artifactName": "CDM-GCP-Setup.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}
