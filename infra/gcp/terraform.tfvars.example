project_id       = "your-gcp-project-id"
project_number     = "123456789012"
region             = "us-central1"
service_name       = "cdm"
container_image    = "us-central1-docker.pkg.dev/your-gcp-project-id/cdm-images/cdm:latest"
app_url            = "https://cdm.yourdomain.com"
nextauth_secret    = "generate-with-openssl-rand-base64-32"
google_client_id   = "your-google-oauth-client-id"
google_client_secret = "your-google-oauth-client-secret"
gemini_api_key     = "your-gemini-api-key"
anthropic_api_key  = "your-anthropic-api-key"
skribby_api_key    = "your-skribby-api-key"
webhook_secret     = "generate-with-openssl-rand-base64-32"
database_url       = ""  # Optional: override auto-generated Cloud SQL URL
