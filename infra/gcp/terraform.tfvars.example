# Copy this file to terraform.tfvars locally. Never commit it or share it by email.
project_id = "your-customer-project-id"
region = "us-central1"
service_name = "cdm"
container_image = "ghcr.io/lalith0192837465-create/cdmai:latest"
app_url = "" # First apply: leave blank; then set to the service_url output and apply again.
database_version = "POSTGRES_16"
database_tier = "db-custom-1-3840" # Customer cloud admin must confirm current availability and cost.
database_availability = "ZONAL" # Review production reliability/cost requirements.
database_disk_gb = 10
max_instances = 3
deletion_protection = true
allow_public_ingress = true
allow_unauthenticated = true # Review application route access/security before enabling.
nextauth_secret = "replace-with-a-customer-generated-random-value"
google_client_id = "replace-with-customer-oauth-client-id"
google_client_secret = "replace-with-customer-oauth-client-secret"
gemini_api_key = "replace-with-customer-gemini-api-key"
anthropic_api_key = "" # Optional only if the customer confirms it is unused.
skribby_api_key = "" # Optional only if the customer confirms it is unused.
webhook_secret = "replace-with-a-customer-generated-random-value"
