generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  roles         String    @default("sales")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  deals    Deal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id                 String    @id @default(cuid())
  zoomUrl            String
  zoomMeetingId      String?
  recallBotId        String?
  transcriptUrl      String?

  customerName       String
  dealName           String?
  dealAmount         Int?
  dealTerm           String?
  discount           Int?
  trialDays          Int?
  customRequirements String?

  extractedTerms     String?
  extractionStatus   String    @default("pending")
  confirmationStatus String    @default("pending")

  financeStatus      String    @default("pending")
  engineeringStatus  String    @default("pending")
  legalStatus        String    @default("pending")

  finalized          Boolean   @default(false)
  finalizedAt        DateTime?

  createdBy          String
  user               User      @relation(fields: [createdBy], references: [id])

  createdAt          DateTime  @default(now())
  updatedAt           DateTime @updatedAt

  @@index([createdBy])
  @@index([confirmationStatus])
}

model RecallWebhookLog {
  id          String   @id @default(cuid())
  botId       String
  status      String
  payload     String
  processedAt Boolean  @default(false)
  createdAt   DateTime @default(now())
}
